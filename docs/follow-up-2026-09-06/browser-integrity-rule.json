{
  "name": "Rust course public read access",
  "kind": "zone",
  "phase": "http_config_settings",
  "rules": [{
    "action": "set_config",
    "action_parameters": {"bic": false},
    "expression": "(http.host eq \"rust.robertdevore.com\" and http.request.method in {\"GET\" \"HEAD\"})",
    "description": "Allow public Rust course readers without browser-signature checks",
    "enabled": true
  }]
}
